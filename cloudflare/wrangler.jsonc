{
  "name": "smat-uiux-mcp",
  "main": "./worker.mjs",
  "compatibility_date": "2026-11-05",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "uiux.smatdesigns.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "GIT_SHA": "UNDEPLOYED"
  },
  "browser": {
    "binding": "MYBROWSER",
    "remote": true
  },
  "ratelimits": [
    {
      "name": "CAPTURE_LIMITER",
      "namespace_id": "9911702",
      "simple": {
        "limit": 4,
        "period": 60
      }
    }
  ],
  "secrets": {
    "required": [
      "MCP_BEARER_TOKEN",
      "MCP_OWNER_TOKEN"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CAPTURE_QUOTA",
        "class_name": "CaptureQuota"
      }
    ]
  },
  "migrations": [
    {
      "tag": "capture-quota-v1",
      "new_sqlite_classes": [
        "CaptureQuota"
      ]
    }
  ],
  "r2_buckets": [
    {
      "binding": "CAPTURE_EVIDENCE",
      "bucket_name": "smat-uiux-owner-capture-v1"
    }
  ]
}
