{
  "name": "smat-interface-lab-browser-pilot",
  "main": "src/index.mjs",
  "compatibility_date": "2026-11-17",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "browser": {
    "binding": "MYBROWSER",
    "remote": true
  },
  "vars": {
    "PILOT_VERSION": "0.1.0"
  }
}
